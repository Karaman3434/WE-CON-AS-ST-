const tKDV=iskBirim*item.quantity*kur*1.20;
t+=(item.berta||'-')+" | "+item.name+" | "+item.quantity+" Adet | "+iskBirim.toFixed(2)+" € | "+tKDV.toFixed(2)+" ₺\n";
